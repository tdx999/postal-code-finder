# ========================================================
# 台灣郵遞區號查詢系統 - 環境變數範本 (.env.example)
# 使用方式：請複製本檔案為 .env.local 並填入您自己的真實設定值
# ========================================================

# --------------------------------------------------------
# 1. 資料庫連線字串 (必填)
# --------------------------------------------------------
# 請使用 Supabase 的「Transaction Pooler」連線 (連接埠 6543)
# 取得路徑：Supabase Dashboard -> Settings -> Database -> Connection string -> Transaction (Port: 6543)
DATABASE_URL="postgresql://postgres.[專案ID]:[你的資料庫密碼]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# --------------------------------------------------------
# 2. Supabase API 設定 (選填，若需前端直接呼叫 Supabase SDK)
# --------------------------------------------------------
# 取得路徑：Supabase Dashboard -> Settings -> API
SUPABASE_URL="https://[你的專案ID].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --------------------------------------------------------
# 3. 流量限制管理 Token (選填)
# --------------------------------------------------------
# 用於存取 /admin/rate-limit-ui 後台管理端點的金鑰
RATE_LIMIT_ADMIN_TOKEN="your-custom-secure-admin-token"

# --------------------------------------------------------
# 4. Google 服務設定 (選填)
# --------------------------------------------------------
# Google Analytics 評估 ID (例如：G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google AdSense 發布商 ID (例如：ca-pub-1234567890123456)
# 若留空或設為 ca-pub-test，前端會以安全佔位符（測試模式）顯示
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-test"

# --------------------------------------------------------
# 5. 應用程式運行環境 (選填)
# --------------------------------------------------------
NODE_ENV="development"
PORT=3000
